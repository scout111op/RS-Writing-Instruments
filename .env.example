# ==========================================
# RS WRITING INSTRUMENTS - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# PUBLIC / CLIENT-EXPOSED VARIABLES (prefix NEXT_PUBLIC_)
# Only place non-sensitive public keys here!
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rswriting.in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA... # Cloudflare Turnstile Public Site Key (Safe for client-side)

# ------------------------------------------
# PRIVATE / SERVER-ONLY SECRETS (NO NEXT_PUBLIC_ PREFIX!)
# WARNING: NEVER expose these to the client-side code!
# ------------------------------------------
TURNSTILE_SECRET_KEY=0x4AAAAAAA... # Cloudflare Turnstile Secret Key (Server-only)
RECAPTCHA_SECRET_KEY=6L... # Google reCAPTCHA Secret Key (Server-only)
EMAIL_SERVER_USER=fountainpenmechanic@gmail.com
EMAIL_SERVER_PASSWORD=your_secure_app_password
DATABASE_URL=postgresql://user:password@localhost:5432/rswriting
